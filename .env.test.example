# =============================================================================
# ApplyNinjaa — TEST environment variables (CLAUDE.md §12)
# Copy to .env.test and point it at an ISOLATED test instance — never the same
# database as production or local dev. Agents default to these creds for any
# "test this" / destructive operation.
#
# When TEST_MODE=true, config/env.schema.ts requires the DB target to match
# TEST_DB_PATTERN (default /test/i), or it refuses to boot.
# =============================================================================

# Must be true so the boot-time test guardrail is enforced.
TEST_MODE=true
# TEST_DB_PATTERN=test              # case-insensitive regex the DB target must match

# Product identity — always required (config/products.ts).
NEXT_PUBLIC_PRODUCT=scrapperninja

# --- Test database (required) ------------------------------------------------
# Use a dedicated test instance whose target matches TEST_DB_PATTERN — a
# separate free cluster at https://cloud.mongodb.com, or a `*-test` database
# name locally.
DB_PROVIDER=mongodb
# MONGODB_URI=mongodb://localhost:27017/applyninjaa-test

# --- Provider test keys --------------------------------------------------------
# Use sandbox/test-mode keys only (e.g. Stripe test keys).
# STRIPE_SECRET_KEY=    # sk_test_...
# RESEND_API_KEY=       # test key
# DEEPSEEK_API_KEY=     # low-quota key for test runs
# EEO_ENCRYPTION_KEY=   # openssl rand -base64 32 — a throwaway test key
