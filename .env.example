# =============================================================================
# Environment variables — ApplyNinjaa / ScrapperNinja (one repo, two products)
# Copy to .env.local and fill in values for the features you enable.
#
# HOW FLAGS WORK (config/features.ts): a feature is ON when its
# NEXT_PUBLIC_FEATURE_* var is present and non-empty (resolved via
# !!process.env.X). To ENABLE, uncomment/set the toggle (e.g. =1). To DISABLE,
# leave it commented out. ⚠︎ ANY non-empty value enables it — including "0" or
# "false" — so disable by removing the line, not by setting it to false.
#
# Each toggle unlocks provider SECRET(s) that become REQUIRED at boot when the
# flag is on (validated in config/env.schema.ts). Secrets are server-only.
# =============================================================================

# --- Product identity (ALWAYS required) --------------------------------------
# Which product this deployment is. Controls name, marketing copy, and legal
# text via config/products.ts. Independent of NEXT_PUBLIC_FEATURE_* flags
# (identity ≠ capability). Valid: applyninja | scrapperninja.
NEXT_PUBLIC_PRODUCT=scrapperninja

# --- Core --------------------------------------------------------------------
# NODE_ENV is set by the runtime (development | test | production).
# Base URL — used to build OAuth redirect URIs and auth email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bypass env validation for builds/CI without real secrets (never at runtime).
# SKIP_ENV_VALIDATION=1

# --- Test environment guardrail (§12) ----------------------------------------
# When true, config/env.schema.ts requires the DB target (MONGODB_URI) to match
# TEST_DB_PATTERN, or it refuses to boot.
# TEST_MODE=false
# TEST_DB_PATTERN=test              # case-insensitive regex the DB target must match

# =============================================================================
# FEATURE FLAGS  (toggles — uncomment to enable)
# ApplyNinjaa's standard set: email-password + Google + LinkedIn auth, payments
# with annual billing, admin panel, cookie banner, DeepSeek AI, Gmail scanning,
# and the job-applications product surface.
# ScrapperNinja's standard set swaps job applications for the scraper product:
# leave NEXT_PUBLIC_FEATURE_JOB_APPLICATIONS off and enable
# NEXT_PUBLIC_FEATURE_SCRAPER (see the Product surfaces section below).
# =============================================================================

# --- Auth --------------------------------------------------------------------
# Enable one or more sign-in methods. Any auth method requires AUTH_SECRET.
NEXT_PUBLIC_FEATURE_AUTH_EMAIL_PASSWORD=1
NEXT_PUBLIC_FEATURE_AUTH_OAUTH_GOOGLE=1
NEXT_PUBLIC_FEATURE_AUTH_OAUTH_LINKEDIN=1
# NEXT_PUBLIC_FEATURE_AUTH_MAGIC_LINK=1
# NEXT_PUBLIC_FEATURE_AUTH_OAUTH_GITHUB=1
#
# Required when ANY auth method is on:
# AUTH_SECRET=                       # random 32+ char secret (signs custom-flow JWTs)
# Required when auth.emailPassword is on (verification-email delivery) and when
# auth.magicLink is on (magic-link delivery):
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=                   # from-address for auth emails (defaults to Resend sandbox)
# Required when auth.oauth.google is on (also reused by the Gmail integration):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Required when auth.oauth.linkedin is on:
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Required when auth.oauth.github is on:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Field-level encryption ----------------------------------------------------
# Encrypts sensitive profile fields (EEO/demographic data) and stored Gmail
# refresh tokens at rest. Required whenever any auth method is on.
# Generate with: openssl rand -base64 32   ⚠︎ losing this key loses that data.
# EEO_ENCRYPTION_KEY=

# --- Roles & super admin (§14) -----------------------------------------------
# Platform super-admin is a flag on the user record, independent of org roles and
# of multi-tenancy. `npm run seed` promotes this user (falls back to the seeded
# admin when unset). Optional — unlocks no secret.
# SUPER_ADMIN_EMAIL=you@example.com

# --- Payments (Stripe) -------------------------------------------------------
NEXT_PUBLIC_FEATURE_PAYMENTS=1
# Cadence sub-flag — when on, plans expose annual pricing + discount and
# checkout offers a monthly/annual toggle. Unlocks no extra secret. (§15)
NEXT_PUBLIC_FEATURE_PAYMENTS_ANNUAL_BILLING=1
# Required when payments is on:
# STRIPE_SECRET_KEY=                 # sk_live_... / sk_test_...
# STRIPE_WEBHOOK_SECRET=             # whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=# pk_live_... / pk_test_... (client-side)

# --- Storage (S3 / S3-compatible) --------------------------------------------
# Not used by ApplyNinjaa v1 (resumes are parsed in-memory and discarded).
# NEXT_PUBLIC_FEATURE_STORAGE=1
# Required when storage is on:
# STORAGE_PROVIDER=s3                # s3 (only provider shipped)
# Required when STORAGE_PROVIDER=s3:
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional — custom endpoint for S3-compatible providers (Cloudflare R2, MinIO):
# AWS_S3_ENDPOINT=

# --- Phone verification (Twilio Verify) --------------------------------------
# Not used by ApplyNinjaa v1.
# NEXT_PUBLIC_FEATURE_PHONE_VERIFICATION=1
# Required when phoneVerification is on:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Admin panel -------------------------------------------------------------
NEXT_PUBLIC_FEATURE_ADMIN=1
# (no extra secret required)

# --- AI providers ------------------------------------------------------------
# Comma-separated list of enabled providers (anthropic, openai, deepseek).
# Empty = off. ApplyNinjaa uses DeepSeek for all AI tasks (resume parsing,
# field mapping, filter classification, fit scoring, Gmail classification).
NEXT_PUBLIC_FEATURE_AI_PROVIDERS=deepseek
# Required per provider listed above:
# DEEPSEEK_API_KEY=                  # when list includes 'deepseek'
# ANTHROPIC_API_KEY=                 # when list includes 'anthropic'
# OPENAI_API_KEY=                    # when list includes 'openai'
# Optional: preferred default provider when several are enabled
# (anthropic|openai|deepseek). Falls back to the first enabled when unset.
# AI_DEFAULT_PROVIDER=deepseek

# --- Gmail integration ---------------------------------------------------------
# Separate opt-in read-only Gmail OAuth + manual inbox scans that propose
# application-status updates. Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# (required even if Google login is off). Add the gmail.readonly scope to the
# Google Cloud OAuth consent screen.
NEXT_PUBLIC_FEATURE_GMAIL=1

# --- Cookie consent ----------------------------------------------------------
# Renders a flag-gated accept/reject banner; the choice is stored in a cookie
# (ninjakit_cookie_consent). No extra secret required. See docs/legal-templates/.
NEXT_PUBLIC_FEATURE_COOKIE_BANNER=1

# --- Product surfaces --------------------------------------------------------
# Two independent product surfaces share this one repo. Identity
# (NEXT_PUBLIC_PRODUCT) picks the branding; these flags pick the capabilities.
#
# Job applications (ApplyNinjaa): profiles, onboarding, applications tracker,
# job filters, Gmail scans, and the resume/field-map AI tasks. OFF by default
# for ScrapperNinja — its routes 404 and their nav hides when this is off.
# NEXT_PUBLIC_FEATURE_JOB_APPLICATIONS=1
#
# Scraper (ScrapperNinja): lead-scraping product surface. Enabled in
# ScrapperNinja's standard set.
NEXT_PUBLIC_FEATURE_SCRAPER=1
# Enrichment pass over scraped leads (Phase 3).
# NEXT_PUBLIC_FEATURE_SCRAPER_ENRICHMENT=1
# Per-lead offer-line generation (Phase 3).
# NEXT_PUBLIC_FEATURE_SCRAPER_OFFER_LINES=1
# Generic (non-site-specific) extractor (Phase 2).
# NEXT_PUBLIC_FEATURE_SCRAPER_GENERIC_EXTRACTOR=1

# --- Multi-tenancy -----------------------------------------------------------
# Off = single silent default org per user (no org UI) — ApplyNinjaa's mode.
# The schema is ALWAYS multi-tenant regardless of this flag.
# NEXT_PUBLIC_FEATURE_MULTI_TENANT=1

# =============================================================================
# DATABASE (CORE — DB_PROVIDER is always required)
# This fork is MongoDB-only (the Supabase adapter was removed per §1.5).
# =============================================================================
DB_PROVIDER=mongodb
# Required:
# MONGODB_URI=mongodb://localhost:27017/applyninjaa
