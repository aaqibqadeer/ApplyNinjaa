{
  "manifest_version": 3,
  "name": "ApplyNinjaa",
  "version": "0.1.0",
  "description": "Screen job postings against your deal-breakers, score your fit, autofill applications, and track them.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyNinjaa"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["__API_ORIGIN__/*"]
}
